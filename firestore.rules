rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------
    // Helper functions
    // ---------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUser() {
      return isSignedIn();
      // TODO: Enable email verification in production
      // return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Check if user is club admin - checks club membership for club-admin role
    function isClubAdmin(clubId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             // Check if user is in the club's member list with club-admin role
             exists(/databases/$(database)/documents/clubs/$(clubId)/allMembers/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/clubs/$(clubId)/allMembers/$(request.auth.uid))
               .data.roles.hasAny(['club-admin']);
    }

    // Check if user has any access to a club - checks clubAccess array
    // Due to Firestore rules limitations with nested arrays, we'll check membership documents
    function hasClubAccess(clubId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             // Check if user is in the club's member list
             exists(/databases/$(database)/documents/clubs/$(clubId)/allMembers/$(request.auth.uid));
    }

    // Check if user has specific role in group - checks nested groupAccess in clubAccess
    // NOTE: Firestore rules don't support complex nested array operations well
    // We'll use a simplified approach that relies on group membership documents for role verification
    function hasGroupRole(clubId, groupId, role) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             // First check if user has access to the club
             hasClubAccess(clubId) &&
             // Check if user is in the group's member list with the specified role
             exists(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/allMembers/$(request.auth.uid)) &&
             // Verify user has the required role in the group member document
             get(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/allMembers/$(request.auth.uid))
               .data.roles.hasAny([role]);
    }

    // Check if user is group admin
    function isGroupAdmin(clubId, groupId) {
      return hasGroupRole(clubId, groupId, 'admin');
    }

    // Check if user is group coach
    function isGroupCoach(clubId, groupId) {
      return hasGroupRole(clubId, groupId, 'coach');
    }

    // Check if user has any access to a group
    function hasGroupAccess(clubId, groupId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
               // User has club admin access
               isClubAdmin(clubId) ||
               // User is a member of this specific group
               exists(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/allMembers/$(request.auth.uid))
             );
    }

    // Check if user can manage group (club admin OR group admin OR group coach)
    function canManageGroup(clubId, groupId) {
      return isClubAdmin(clubId) || isGroupAdmin(clubId, groupId) || isGroupCoach(clubId, groupId);
    }

    // Check if user can create groups (club admin only)
    function canCreateGroup(clubId) {
      return isClubAdmin(clubId);
    }

    // Check if user is the club creator
    function isClubCreator(clubId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/clubs/$(clubId)) &&
             get(/databases/$(database)/documents/clubs/$(clubId)).data.createdBy == request.auth.uid;
    }

    // Validate clubAccess array structure (simplified for Firestore rules syntax)
    function validateClubAccessArray(clubAccess) {
      return clubAccess is list &&
             clubAccess.size() <= 100;
    }

    // Validate groupAccess array structure (simplified for Firestore rules syntax)
    function validateGroupAccessArray(groupAccess) {
      return groupAccess is list &&
             groupAccess.size() <= 50;
    }

    // Check if current user has club admin access to update target user (simplified)
    function hasClubAdminAccessToUpdateUser(targetUserId) {
      return exists(/databases/$(database)/documents/users/$(targetUserId)) &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Validation function for user documents using clubAccess array
    function validateUserDocument(data) {
      return data.keys().hasAll(['email', 'displayName', 'createdAt']) &&
             data.email is string &&
             data.displayName is string &&
             (data.createdAt is timestamp || data.createdAt == request.time) &&
             // clubAccess array validation (replaces clubs and groupsJoined)
             (!('clubAccess' in data) || (
               data.clubAccess is list &&
               data.clubAccess.size() <= 100 &&
               validateClubAccessArray(data.clubAccess)
             )) &&
             // Optional fields validation
             (!('photoURL' in data) || data.photoURL is string) &&
             (!('profilePicture' in data) || data.profilePicture is string) &&
             (!('dateOfBirth' in data) || data.dateOfBirth is timestamp) &&
             (!('phoneNumber' in data) || data.phoneNumber is string) &&
             (!('emailVerified' in data) || data.emailVerified is bool) &&
             (!('verificationStatus' in data) || data.verificationStatus is string) &&
             (!('version' in data) || data.version is number) &&
             (!('groupsCreated' in data) || data.groupsCreated is number) &&
             (!('events' in data) || data.events is list) &&
             (!('eventsResponses' in data) || data.eventsResponses is list) &&
             (!('groupInvites' in data) || data.groupInvites is list) &&
             (!('lastActive' in data) || (data.lastActive is timestamp || data.lastActive == request.time)) &&
             (!('uid' in data) || data.uid is string) &&
             (!('address' in data) || data.address is map) &&
             (!('preferences' in data) || data.preferences is map) &&
             (!('isActive' in data) || data.isActive is bool) &&
             (!('lastLoginAt' in data) || (data.lastLoginAt is timestamp || data.lastLoginAt == request.time));
    }

    // ---------------------------
    // Users collection - using clubAccess array structure
    // ---------------------------
    match /users/{userId} {
      // Read: Only authenticated user can read their own document
      allow read: if isSignedIn() && request.auth.uid == userId;

      // Create: Users can only create their own document with required fields
      allow create: if isSignedIn() && 
                       request.auth.uid == userId &&
                       validateUserDocument(request.resource.data);

      // Update: Users can update their own document, OR club-admin can update clubAccess field
      allow update: if (request.auth.uid == userId && validateUserDocument(request.resource.data)) ||
                       (
                         isSignedIn() &&
                         request.auth.uid != userId &&
                         // Check if current user is club admin in any of target user's clubs
                         hasClubAdminAccessToUpdateUser(userId) &&
                         // Club-admins can only update 'clubAccess' field
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clubAccess'])
                       );

      // Delete: Users can only delete their own document
      allow delete: if isSignedIn() && request.auth.uid == userId;


    }

    // ---------------------------
    // Clubs collection
    // ---------------------------
    match /clubs/{clubId} {
      // Read: Any authenticated user can read club info
      allow read: if isSignedIn();
      
      // Create: Any authenticated user can create a club
      allow create: if isSignedIn();
      
      // Update/Delete: Only club admins or club creator
      allow update, delete: if isClubAdmin(clubId) || isClubCreator(clubId);

      // Groups subcollection inside a club
      match /groups/{groupId} {
        // Read: Any authenticated user can read group info
        allow read: if isSignedIn();
        
        // Create: Only club admins can create groups
        allow create: if canCreateGroup(clubId);
        
        // Update: Club admins or group admins/coaches can update
        allow update: if canManageGroup(clubId, groupId);
        
        // Delete: Only club admins or group admins
        allow delete: if isClubAdmin(clubId) || isGroupAdmin(clubId, groupId);
        
        // Subgroups subcollection
        match /subgroups/{subgroupId} {
          allow read: if isSignedIn();
          allow create, update, delete: if canManageGroup(clubId, groupId);
        }

        // All Members subcollection - contains member documents for the group
        match /allMembers/{memberId} {
          // Read: Club admins, group admins/coaches, or group members can read member data
          allow read: if isClubAdmin(clubId) || canManageGroup(clubId, groupId) || hasGroupAccess(clubId, groupId);
          
          // Create/Update: Only club admins or group admins/coaches can manage members
          allow create, update: if isClubAdmin(clubId) || canManageGroup(clubId, groupId);
          
          // Delete: Only club admins or group admins can remove members
          allow delete: if isClubAdmin(clubId) || isGroupAdmin(clubId, groupId);
        }

        // Events subcollection (for future use)
        match /events/{eventId} {
          allow read: if hasGroupAccess(clubId, groupId) || isClubAdmin(clubId);
          allow create, update, delete: if canManageGroup(clubId, groupId);
        }

        // Results subcollection (for future use)
        match /results/{resultId} {
          allow read: if hasGroupAccess(clubId, groupId) || isClubAdmin(clubId);
          allow create, update, delete: if canManageGroup(clubId, groupId);
        }
      }
    }

    // ---------------------------
    // Invitations collection - Group invitation system
    // ---------------------------
    match /invitations/{invitationToken} {
      // Allow reading for:
      // 1. Users whose email matches the invitation email
      // 2. Club admins who can manage the club the invitation is for
      // 3. Users who created the invitation
      allow read: if isSignedIn() && 
                     (resource.data.email == request.auth.token.email ||
                      isClubAdmin(resource.data.clubId) ||
                      resource.data.inviterUid == request.auth.uid);
      
      // Allow creating invitations for authenticated users
      allow create: if isSignedIn();
      
      // Allow updating/deleting for:
      // 1. Club admins of the target club
      // 2. Users who created the invitation
      allow update, delete: if isSignedIn() && 
                            (isClubAdmin(resource.data.clubId) || 
                             resource.data.inviterUid == request.auth.uid);
    }

    // ---------------------------
    // Guardian Invitations collection (for future use)
    // ---------------------------
    match /guardianInvitations/{invitationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && 
                            (resource.data.createdBy == request.auth.uid || 
                             resource.data.guardianEmail == request.auth.token.email);
    }

    // ---------------------------
    // Global Events collection (for future use)
    // ---------------------------
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
