rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------
    // Helper functions
    // ---------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUser() {
      return isSignedIn();
      // TODO: Enable email verification in production
      // return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // NEW: Check if user is club admin (from single allMembers document)
    function isClubAdmin(clubId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/clubs/$(clubId)/allMembers/members) &&
             get(/databases/$(database)/documents/clubs/$(clubId)/allMembers/members).data.members
               .hasAny([{'userId': request.auth.uid, 'roles': ['club-admin']}]);
    }

    // NEW: Check if user is member of a group (from single allMembers document)
    function isGroupMember(clubId, groupId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/allMembers/members) &&
             get(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/allMembers/members).data.members
               .hasAny([{'userId': request.auth.uid}]);
    }

    // NEW: Check if user has specific role in group
    function hasGroupRole(clubId, groupId, role) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/allMembers/members) &&
             get(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/allMembers/members).data.members
               .hasAny([{'userId': request.auth.uid, 'roles': [role]}]);
    }

    // NEW: Check if user is group admin
    function isGroupAdmin(clubId, groupId) {
      return hasGroupRole(clubId, groupId, 'admin');
    }

    // NEW: Check if user is group coach
    function isGroupCoach(clubId, groupId) {
      return hasGroupRole(clubId, groupId, 'coach');
    }

    // NEW: Check if user can manage group (club admins OR club creator OR group admins OR group coaches)
    function canManageGroup(clubId, groupId) {
      return isClubAdmin(clubId) || isClubCreator(clubId) || isGroupAdmin(clubId, groupId) || isGroupCoach(clubId, groupId);
    }

    // NEW: Check if user can create groups (club admins OR club creator)
    function canCreateGroup(clubId) {
      return isClubAdmin(clubId) || isClubCreator(clubId);
    }

    // NEW: Check if user is the club creator
    function isClubCreator(clubId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/clubs/$(clubId)) &&
             get(/databases/$(database)/documents/clubs/$(clubId)).data.createdBy == request.auth.uid;
    }

    // ---------------------------
    // Users collection
    // ---------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      // Users can create their own document
      allow create: if request.auth.uid == userId;

      // Users can update/delete their own document OR club-admin can update other users in same club
      allow update, delete: if (request.auth.uid == userId) ||
                             (
                               isSignedIn() &&
                               request.auth.uid != userId &&
                               // Check if current user is club admin in any club that target user belongs to
                               get(/databases/$(database)/documents/users/$(userId)).data.clubs
                                 .hasAny(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubs
                                   .where(c, c.isAdmin == true)
                                   .map(c, c.clubId)) &&
                               // Club-admins can only update 'clubs' and 'groupsJoined' fields
                               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clubs', 'groupsJoined'])
                             );
    }

    // ---------------------------
    // Clubs collection
    // ---------------------------
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isClubAdmin(clubId);

      // NEW: Single allMembers document (club members)
      match /allMembers/{memberDocId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isClubAdmin(clubId);
        allow delete: if isClubAdmin(clubId);
      }

      // Groups subcollection inside a club
      match /groups/{groupId} {
        allow read: if isSignedIn();
        allow create: if canCreateGroup(clubId); // Only club admins can create groups
        allow update: if canManageGroup(clubId, groupId);
        allow delete: if isClubAdmin(clubId) || isGroupAdmin(clubId, groupId);

        // NEW: Single allMembers document (group members)
        match /allMembers/{memberDocId} {
          allow read: if isSignedIn();
          allow create: if canManageGroup(clubId, groupId); // Only managers can create member lists
          allow update: if canManageGroup(clubId, groupId); // Only managers can update members
          allow delete: if canManageGroup(clubId, groupId);
        }
        
        // Subgroups subcollection
        match /subgroups/{subgroupId} {
          allow read: if isSignedIn();
          allow create, update, delete: if canManageGroup(clubId, groupId);
        }

        // Events subcollection (for future use)
        match /events/{eventId} {
          allow read: if isGroupMember(clubId, groupId) || isClubAdmin(clubId);
          allow create, update, delete: if canManageGroup(clubId, groupId);
        }

        // Results subcollection (for future use)
        match /results/{resultId} {
          allow read: if isGroupMember(clubId, groupId) || isClubAdmin(clubId);
          allow create, update, delete: if canManageGroup(clubId, groupId);
        }
      }
    }

    // ---------------------------
    // Guardian Invitations collection (for future use)
    // ---------------------------
    match /guardianInvitations/{invitationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && 
                            (resource.data.createdBy == request.auth.uid || 
                             resource.data.guardianEmail == request.auth.token.email);
    }

    // ---------------------------
    // Global Events collection (for future use)
    // ---------------------------
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
