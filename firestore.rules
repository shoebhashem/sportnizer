rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------
    // Helper functions
    // ---------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUser() {
      return isSignedIn();
      // TODO: Enable email verification in production
      // return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isClubAdmin(clubId) {
      return isSignedIn() &&
             (
               // Case 1: userId is in club.adminIds
               request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.adminIds ||

               // Case 2: user's own document has clubs[].clubId == clubId && isAdmin == true
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.clubs
                 .where(c, c.clubId == clubId && c.isAdmin == true)
                 .size() > 0
             );
    }

    function isGroupMember(clubId, groupId) {
      return exists(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/allMembers/$(request.auth.uid));
    }

    function isGroupAdmin(clubId, groupId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/allMembers/$(request.auth.uid)) &&
             'admin' in get(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/allMembers/$(request.auth.uid)).data.roles;
    }

    function isGroupCoach(clubId, groupId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/allMembers/$(request.auth.uid)) &&
             'coach' in get(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/allMembers/$(request.auth.uid)).data.roles;
    }

    function canManageGroup(clubId, groupId) {
      return isClubAdmin(clubId) || isGroupAdmin(clubId, groupId) || isGroupCoach(clubId, groupId);
    }

    // ---------------------------
    // Email verification collection
    // ---------------------------
    match /emailVerifications/{tokenId} {
      allow read, write: if false;
    }

    // ---------------------------
    // Users collection
    // ---------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      // Listing users: club admins can list users in their club; group members can list users in their group
      allow list: if isSignedIn() &&
                  (request.query.where.clubId != null && isClubAdmin(request.query.where.clubId) ||
                   request.query.where.groupId != null && isGroupMember(request.query.where.clubId, request.query.where.groupId));

      // Users can create their own document
      allow create: if request.auth.uid == userId;

      // Users can update/delete their own document OR club-admin can update other users in same club
      allow update, delete: if (request.auth.uid == userId) ||
                             (
                               isSignedIn() &&
                               request.auth.uid != userId &&
                               // Check target user is in a club where current user is admin
                               get(/databases/$(database)/documents/users/$(userId)).data.clubs
                                 .where(c, c.clubId in
                                     get(/databases/$(database)/documents/users/$(request.auth.uid))
                                       .data.clubs
                                       .where(ca, ca.isAdmin == true)
                                       .map(ca, ca.clubId)
                                 ).size() > 0 &&
                               // Club-admins can only update 'clubs' and 'groupsJoined' fields
                               request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clubs', 'groupsJoined'])
                             );
    }

    // ---------------------------
    // Clubs collection
    // ---------------------------
    match /clubs/{clubId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isClubAdmin(clubId);

      // AllMembers subcollection (club members)
      match /allMembers/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isClubAdmin(clubId) || request.auth.uid == userId;
        allow delete: if isClubAdmin(clubId) || request.auth.uid == userId;
      }

      // Groups subcollection inside a club
      match /groups/{groupId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn(); // Allow any signed-in user to create groups
        allow update: if canManageGroup(clubId, groupId);
        allow delete: if isClubAdmin(clubId) || isGroupAdmin(clubId, groupId);

        // AllMembers subcollection (group members)
        match /allMembers/{userId} {
          allow read: if isSignedIn();
          allow create: if isSignedIn(); // Allow joining groups
          allow update: if canManageGroup(clubId, groupId) || request.auth.uid == userId;
          allow delete: if canManageGroup(clubId, groupId) || request.auth.uid == userId;
        }
        
        // Subgroups subcollection
        match /subgroups/{subgroupId} {
          allow read: if isSignedIn();
          allow create, update, delete: if canManageGroup(clubId, groupId);
        }

        // Events subcollection (for future use)
        match /events/{eventId} {
          allow read: if isGroupMember(clubId, groupId);
          allow create, update, delete: if canManageGroup(clubId, groupId);
        }

        // Results subcollection (for future use)
        match /results/{resultId} {
          allow read: if isGroupMember(clubId, groupId);
          allow create, update, delete: if canManageGroup(clubId, groupId);
        }
      }
    }

    // ---------------------------
    // Guardian Invitations collection (for future use)
    // ---------------------------
    match /guardianInvitations/{invitationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && 
                            (resource.data.createdBy == request.auth.uid || 
                             resource.data.guardianEmail == request.auth.token.email);
    }

    // ---------------------------
    // Global Events collection (for future use)
    // ---------------------------
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
