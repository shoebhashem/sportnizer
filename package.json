    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native-vector-icons/material-icons": "^13.1.3",
    "expo": "^57.0.0",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-localization": "~57.0.1",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.1.0",
    "i18next": "^25.8.13",
    "react": "19.2.3",
    "react-datepicker": "^8.7.0",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.4",
    "react-native": "0.86.3",
