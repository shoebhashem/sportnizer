{
  "name": "clubnizer",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "sync:ios-version": "node ./scripts/sync-ios-version.js",
    "eas-build-pre-install": "npm run sync:ios-version",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "npx expo export --platform web",
    "build:android": "echo 'Use EAS Build: npx eas build --platform android'",
    "build:ios": "echo 'Use EAS Build: npx eas build --platform ios'",
    "typecheck": "npx tsc --noEmit",
    "lint": "expo lint"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
