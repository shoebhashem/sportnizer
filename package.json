    "expo-web-browser": "~56.0.6",
    "firebase": "^12.1.0",
    "i18next": "^25.8.13",
    "react": "19.2.3",
    "react-datepicker": "^8.7.0",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.4",
