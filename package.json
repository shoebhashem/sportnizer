    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native-vector-icons/material-icons": "^13.1.3",
    "expo": "^56.0.0",
    "expo-blur": "~56.0.4",
    "expo-constants": "~56.0.25",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.12",
    "expo-image-manipulator": "~56.0.26",
