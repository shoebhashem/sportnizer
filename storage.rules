rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ========================================================================
    // DEFAULT PROFILE PICTURES - Public read, admin-only write (via console)
    // ========================================================================
    match /defaults/{filename} {
      allow read: if true;
      allow write: if false;
    }

    // ========================================================================
    // PROFILE PICTURES - Uploads + resized images by extension
    // Upload path:  profilePictures/{userId}/profile.{ext}
    // Resized path: profilePictures/{userId}/customProfilePictures/profile_200x200.png
    // ========================================================================
    match /profilePictures/{userId}/{allPaths=**} {
      // Public read for originals and resized images
      allow read: if true;

      // Only the user themselves can upload their own profile picture
      // (resize extension writes via Admin SDK, which bypasses rules)
      allow write: if request.auth != null &&
                   request.auth.uid == userId &&
                   request.resource.size < 5 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/.*');
    }

    // ========================================================================
    // DENY ALL OTHER PATHS
    // ========================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
