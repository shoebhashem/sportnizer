rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions (similar to your Firestore rules)
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidUser() {
      return isSignedIn();
      // TODO: Enable email verification in production
      // return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    // Helper function to check if user has specific role in a group
    function hasRoleInGroup(groupId, role) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
             role in get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.roles;
    }
    
    function isGroupAdmin(groupId) {
      return hasRoleInGroup(groupId, 'admin');
    }
    
    function isGroupCoach(groupId) {
      return hasRoleInGroup(groupId, 'coach');
    }
    
    function canManageGroup(groupId) {
      return isGroupAdmin(groupId) || isGroupCoach(groupId);
    }

    // DEFAULT PROFILE PICTURES
    // Public read access for default profile pictures (like your Firestore read access)
    match /defaults/{filename} {
      allow read: if true; // Public read access for defaults
      allow write: if false; // Only admins can upload defaults via console
    }

    // USER PROFILE PICTURES  
    // Mirrors your Firestore users/{userId} pattern
    match /profile-pictures/users/{userId}/{filename} {
      // Public read access (same as your Firestore users collection)
      allow read: if true;
      
      // Users can only write their own profile pictures
      // Mirrors your Firestore rule: request.auth.uid == userId
      allow write: if isSignedIn() && 
                   request.auth.uid == userId &&
                   // File size limit: 5MB for profile pictures
                   request.resource.size < 5 * 1024 * 1024 &&
                   // Only allow image files
                   request.resource.contentType.matches('image/.*');
    }

    // GROUP CONTENT (Events, Announcements, etc.)
    // For future use when groups can upload images/documents
    match /groups/{groupId}/content/{contentType}/{filename} {
      // Group members can read group content
      allow read: if isSignedIn();
      
      // Only admins and coaches can upload group content
      // Mirrors your canCreateContent() function from Firestore
      allow write: if isSignedIn() && 
                   canManageGroup(groupId) &&
                   // File size limit: 10MB for group content
                   request.resource.size < 10 * 1024 * 1024;
    }

    // CHILD PROFILE PICTURES (for ageGroup 1 groups)
    // Special rules for child profiles - guardians can manage
    match /profile-pictures/children/{childId}/{filename} {
      // Public read access
      allow read: if true;
      
      // Guardians can upload pictures for their children
      // Group admins/coaches can also manage child pictures
      allow write: if isSignedIn() && 
                   (
                     // Check if user is guardian of this child across any group
                     exists(/databases/$(database)/documents/groups) ||
                     // For now, allow any authenticated user (will be refined)
                     true
                   ) &&
                   // File size limit: 5MB
                   request.resource.size < 5 * 1024 * 1024 &&
                   // Only allow image files
                   request.resource.contentType.matches('image/.*');
    }

    // TEMPORARY UPLOADS (for processing before moving to final location)
    match /temp-uploads/{userId}/{filename} {
      // Users can upload to their temp folder
      allow read, write: if isSignedIn() && 
                         request.auth.uid == userId &&
                         // File size limit: 10MB
                         request.resource.size < 10 * 1024 * 1024;
    }

    // DENY ALL OTHER PATHS
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
