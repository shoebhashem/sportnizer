rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ========================================================================
    // DEFAULT PROFILE PICTURES - Public read, admin-only write (via console)
    // ========================================================================
    match /defaults/{filename} {
      allow read: if true;
      allow write: if false;
    }

    // ========================================================================
    // PROFILE PICTURES - Uploads + resized images by extension
    // Upload path:  profilePictures/users/{userId}/profile.{ext}
    // Resized path: profilePictures/users/{userId}/customProfilePictures/profile_200x200.png
    // Club logos:   profilePictures/clubs/{clubId}/logo.jpg (uploaded via CF/Admin SDK)
    // Group pics:   profilePictures/groups/{groupId}/logo.jpg (uploaded via CF/Admin SDK)
    // ========================================================================

    // User profile pictures — users can upload their own
    match /profilePictures/users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
                   request.auth.uid == userId &&
                   request.resource.size < 5 * 1024 * 1024 &&
                   request.resource.contentType.matches('image/.*');
    }

    // Club logos and group pictures — public read, write only via Admin SDK (Cloud Functions)
    match /profilePictures/{entityType}/{entityId}/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Only Admin SDK (Cloud Functions) can write
    }

    // ========================================================================
    // DENY ALL OTHER PATHS
    // ========================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
