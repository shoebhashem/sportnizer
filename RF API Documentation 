Exempel SiteVision
define(function(require) {
    'use strict';
    const appData = require('appData');
    const requester = require('Requester');
    const jwtUtil = require('JwtUtil');
    const timestampUtil = require('TimestampUtil');
    
    const tokenUrl = appData.get('token-url');
    const clientId = appData.get('client-id');
    const clientSecret = appData.get('client-secret');
    const privateKey = appData.getNode('private-key');

    const randomUUID = () => {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
            let r = Math.random()*16|0, v = c == 'x' ? r : (r&0x3|0x8);
            return v.toString(16);
        });
    }

    const getJWT = () => {
        const payload = {
            client_id: clientId,
            sub: clientId,
            iss: clientId,
            jti: randomUUID(),
            organizationId: <organizationId>,
            aud: tokenUrl,
            exp: timestampUtil.getTimestamp() + ((10 * 60) * 1000)
        }
        return jwtUtil.createRSAToken(payload, 'RS256', privateKey, '');
    }

    const getToken = () => {
        let token;
        const options = {
            contentType: 'application/x-www-form-urlencoded',
            data: {
                grant_type: 'urn:ietf:params:oauth:grant-type:jwt-bearer',
                client_id: clientId,
                client_secret: clientSecret,
                scope: 'api',
                assertion: getJWT(),
            }
        }

        requester.post(tokenUrl, options)
            .done(result => {
                token = result;
                token.success = true;
            })
            .fail((message, status) => {
                if(status.body && status.body.error) {
                    message += ' Error: ' + status.body.error;
                }
                token.message = message;
                token.success = false;
            })
        return token;
    }

    return {
        getToken: getToken
    }
});

