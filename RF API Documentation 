import java.time.LocalDateTime
import java.time.ZoneId
import java.util.Base64
import java.util.Date
import java.util.UUID

class JWTSigning {

    fun getSignedJwt(clientId: String, privateKey: String, organizationId: String): String {
        val keyFactory = KeyFactory.getInstance("RSA")
        val rsaPrivateKey = getRSAPrivateKey(privateKey, keyFactory)
        return JWT.create()
                .withClaim("client_id", clientId)
                .withClaim("sub", clientId)
                .withClaim("iss", clientId)
                .withClaim("jti", UUID.randomUUID().toString())
                .withClaim("aud", "https://login.test.idrottonline.se/apim/oauth-token")
                .withClaim("organizationId", organizationId)
                .withClaim("exp", Date.from(LocalDateTime.now().plusMinutes(5L).atZone(ZoneId.systemDefault()).toInstant()))
                .sign(Algorithm.RSA256(rsaPrivateKey))
    }

    private fun getRSAPrivateKey(privateKey: String, keyFactory: KeyFactory): RSAPrivateKey {
        val privateKeyAsBytes = Base64.getDecoder().decode(privateKey)
        val privateKeySpec = PKCS8EncodedKeySpec(privateKeyAsBytes)
        return keyFactory.generatePrivate(privateKeySpec) as RSAPrivateKey
    }
}
