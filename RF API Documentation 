using Microsoft.IdentityModel.Tokens;
using System.IdentityModel.Tokens.Jwt;
using System.Security.Claims;
using System.Security.Cryptography;
using System.Security.Cryptography.X509Certificates;

public string CreateJwtClientAssertion(string tokenEndpoint, string clientId, int organizationId, string privateKey)
        {
            byte[] data = Convert.FromBase64String(privateKey);

            var cert = CertificateUtils.CreateCertificate(KeyUtils.GetPrivateKey(data), "Some_subject", 30);

            var tokenHandler = new JwtSecurityTokenHandler();
            var tokenDescriptor = new SecurityTokenDescriptor
            {
                Expires = DateTime.UtcNow.AddMinutes(960),
                SigningCredentials = new SigningCredentials(new X509SecurityKey(cert), SecurityAlgorithms.RsaSha256Signature),
                Subject = new ClaimsIdentity(new List<Claim>
                {
                    new Claim("client_id", clientId),
                    new Claim("sub", clientId),
                    new Claim("iss", clientId),
                    new Claim("jti", Guid.NewGuid().ToString()),
                    new Claim("aud", tokenEndpoint),
                    new Claim("organizationId", organizationId.ToString())
                })
            };
            return tokenHandler.WriteToken(tokenHandler.CreateJwtSecurityToken(tokenDescriptor));
        }
        
    public class KeyUtils
    {
        public static RSA GetPrivateKey(byte[] privateKey)
        {
            var rsa = RSA.Create();
            rsa.ImportPkcs8PrivateKey(privateKey, out _);
            return rsa;
        }
    }

    public class CertificateUtils
    {
        public static X509Certificate2 CreateCertificate(RSA privateKey, string subjectName, int validityDays)
        {
            var request = new CertificateRequest($"CN={subjectName}", privateKey, HashAlgorithmName.SHA256, RSASignaturePadding.Pkcs1);
            var notBefore = DateTime.UtcNow.Date;
            var notAfter = notBefore.AddDays(validityDays);
            var certificate = request.CreateSelfSigned(notBefore, notAfter);
            return new X509Certificate2(certificate.Export(X509ContentType.Pfx));
        }
    }
