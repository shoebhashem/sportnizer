Create JWT Assertion

import com.auth0.jwt.JWT;
import com.auth0.jwt.algorithms.Algorithm;

import java.security.KeyFactory;
import java.security.NoSuchAlgorithmException;
import java.security.interfaces.RSAPrivateKey;
import java.security.spec.InvalidKeySpecException;
import java.security.spec.PKCS8EncodedKeySpec;
import java.time.LocalDateTime;
import java.time.ZoneId;
import java.util.Base64;
import java.util.Date;
import java.util.UUID;

public class JWTSigning {

    public String getSignedJwt(String clientId, String privateKey, String organizationId) throws NoSuchAlgorithmException, InvalidKeySpecException {
        final var keyFactory = KeyFactory.getInstance("RSA");
        final var rsaPrivateKey = getRSAPrivateKey(privateKey, keyFactory);

        return JWT.create()
                .withClaim("client_id", clientId)
                .withClaim("sub", clientId)
                .withClaim("iss", clientId)
                .withClaim("jti", UUID.randomUUID().toString())
                .withClaim("aud", "https://login-int.idrottonline.se/apim/oauth-token")
                .withClaim("organizationId", organizationId)
                .withClaim("exp", Date.from(LocalDateTime.now().plusMinutes(5L).atZone(ZoneId.systemDefault()).toInstant()))
                .sign(Algorithm.RSA256(rsaPrivateKey));
    }

    private RSAPrivateKey getRSAPrivateKey(String privateKey, KeyFactory keyFactory) throws InvalidKeySpecException {
        final var privateKeyAsBytes = Base64.getDecoder().decode(privateKey);
        final var privateKeySpec = new PKCS8EncodedKeySpec(privateKeyAsBytes);
        return (RSAPrivateKey) keyFactory.generatePrivate(privateKeySpec);
    }
}
