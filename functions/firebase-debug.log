[debug] [2026-03-15T15:48:34.366Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/sportnizer:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // ---------------------------\n    // Helper functions\n    // ---------------------------\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isValidUser() {\n      return isSignedIn();\n      // TODO: Enable email verification in production\n      // return isSignedIn() && request.auth.token.email_verified == true;\n    }\n\n    function isVerifiedUser() {\n      return isSignedIn() && request.auth.token.email_verified == true;\n    }\n\n    // ---------------------------------------------------------------------------\n    // Flat-array based permission helpers\n    // These read a SINGLE document (/users/{uid}) which Firestore caches per\n    // request, making subsequent calls free within the same rule evaluation.\n    // ---------------------------------------------------------------------------\n\n    function getUserData() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\n    }\n\n    // Check if user is club admin — reads flat array adminOfClubs on user doc\n    function isClubAdmin(clubId) {\n      return isSignedIn() &&\n             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n             clubId in getUserData().adminOfClubs;\n    }\n\n    // Check if user has any access to a club (admin or member)\n    function hasClubAccess(clubId) {\n      return isSignedIn() &&\n             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n             (clubId in getUserData().adminOfClubs ||\n              clubId in getUserData().memberOfClubs);\n    }\n\n    // Check if user has specific role in group\n    function hasGroupRole(clubId, groupId, role) {\n      return isSignedIn() &&\n             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n             hasClubAccess(clubId) &&\n             (\n               (role == 'admin' && groupId in getUserData().adminOfGroups) ||\n               (role == 'coach' && groupId in getUserData().coachOfGroups) ||\n               (role == 'guardian' && groupId in getUserData().guardianOfGroups) ||\n               // For any other role, check memberOfGroups\n               groupId in getUserData().memberOfGroups\n             );\n    }\n\n    // Check if user is group admin\n    function isGroupAdmin(clubId, groupId) {\n      return isClubAdmin(clubId) ||\n             (isSignedIn() &&\n              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n              groupId in getUserData().adminOfGroups);\n    }\n\n    // Check if user is group coach\n    function isGroupCoach(clubId, groupId) {\n      return isSignedIn() &&\n             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n             groupId in getUserData().coachOfGroups;\n    }\n\n    // Check if user has any access to a group (member, admin, coach, guardian, or club-admin)\n    function hasGroupAccess(clubId, groupId) {\n      return isSignedIn() &&\n             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n             (\n               isClubAdmin(clubId) ||\n               groupId in getUserData().memberOfGroups ||\n               groupId in getUserData().guardianOfGroups\n             );\n    }\n\n    // Check if user can manage group (club admin OR group admin OR group coach)\n    function canManageGroup(clubId, groupId) {\n      return isClubAdmin(clubId) || isGroupAdmin(clubId, groupId) || isGroupCoach(clubId, groupId);\n    }\n\n    // Check if user can create groups (club admin only)\n    function canCreateGroup(clubId) {\n      return isClubAdmin(clubId);\n    }\n\n    // Check if user is the club creator\n    function isClubCreator(clubId) {\n      return isSignedIn() &&\n             exists(/databases/$(database)/documents/clubs/$(clubId)) &&\n             get(/databases/$(database)/documents/clubs/$(clubId)).data.createdBy == request.auth.uid;\n    }\n\n    // Check if user is a guardian of a youth member\n    function isGuardianOf(youthUserId) {\n      return isSignedIn() &&\n             exists(/databases/$(database)/documents/users/$(youthUserId)) &&\n             get(/databases/$(database)/documents/users/$(youthUserId)).data.guardians != null;\n      // Note: Full dependent relationship checking moved to backend for security\n    }\n\n    // Check if user has access to youth member data (guardian or club admin)\n    function canAccessYouthMember(youthUserId) {\n      return isSignedIn() && (\n        request.auth.uid == youthUserId ||\n        isGuardianOf(youthUserId)\n      );\n    }\n\n    // Validate clubAccess array structure (simplified for Firestore rules syntax)\n    function validateClubAccessArray(clubAccess) {\n      return clubAccess is list &&\n             clubAccess.size() <= 100;\n    }\n\n    // Validate groupAccess array structure (simplified for Firestore rules syntax)\n    function validateGroupAccessArray(groupAccess) {\n      return groupAccess is list &&\n             groupAccess.size() <= 50;\n    }\n\n    // Check if current user has club admin access to update target user (simplified)\n    function hasClubAdminAccessToUpdateUser(targetUserId) {\n      return exists(/databases/$(database)/documents/users/$(targetUserId)) &&\n             exists(/databases/$(database)/documents/users/$(request.auth.uid));\n    }\n\n    // Validation function for user documents using clubAccess array\n    function validateUserDocument(data) {\n      return data.keys().hasAll(['email', 'displayName', 'createdAt']) &&\n             data.email is string &&\n             data.displayName is string &&\n             (data.createdAt is timestamp || data.createdAt == request.time) &&\n             // clubAccess array validation (replaces clubs and groupsJoined)\n             (!('clubAccess' in data) || (\n               data.clubAccess is list &&\n               data.clubAccess.size() <= 100 &&\n               validateClubAccessArray(data.clubAccess)\n             )) &&\n             // Flat role arrays validation\n             (!('adminOfClubs' in data) || data.adminOfClubs is list) &&\n             (!('memberOfClubs' in data) || data.memberOfClubs is list) &&\n             (!('adminOfGroups' in data) || data.adminOfGroups is list) &&\n             (!('coachOfGroups' in data) || data.coachOfGroups is list) &&\n             (!('memberOfGroups' in data) || data.memberOfGroups is list) &&\n             (!('guardianOfGroups' in data) || data.guardianOfGroups is list) &&\n             // Youth member fields validation\n             (!('guardians' in data) || data.guardians is list) &&\n             (!('dependents' in data) || data.dependents is list) &&\n             (!('isYouthMember' in data) || data.isYouthMember is bool) &&\n             // Optional fields validation\n             (!('photoURL' in data) || data.photoURL is string) &&\n             (!('profilePicture' in data) || data.profilePicture is string) &&\n             (!('dateOfBirth' in data) || data.dateOfBirth is timestamp) &&\n             (!('phoneNumber' in data) || data.phoneNumber is string) &&\n             (!('emailVerified' in data) || data.emailVerified is bool) &&\n             (!('verificationStatus' in data) || data.verificationStatus is string) &&\n             (!('version' in data) || data.version is number) &&\n             (!('groupsCreated' in data) || data.groupsCreated is number) &&\n             (!('events' in data) || data.events is list) &&\n             (!('eventsResponses' in data) || data.eventsResponses is list) &&\n             (!('groupInvites' in data) || data.groupInvites is list) &&\n             (!('lastActive' in data) || (data.lastActive is timestamp || data.lastActive == request.time)) &&\n             (!('uid' in data) || data.uid is string) &&\n             (!('address' in data) || data.address is map) &&\n             (!('preferences' in data) || data.preferences is map) &&\n             (!('isActive' in data) || data.isActive is bool) &&\n             (!('lastLoginAt' in data) || (data.lastLoginAt is timestamp || data.lastLoginAt == request.time));\n    }\n\n    // ---------------------------\n    // Users collection - using clubAccess array structure\n    // ---------------------------\n    match /users/{userId} {\n      // Read: User can read their own document OR guardians can read their dependents' documents\n      allow read: if isSignedIn() && (\n        request.auth.uid == userId ||\n        isGuardianOf(userId)\n      );\n\n      // Create: Users can only create their own document with required fields\n      // OR backend functions can create youth member documents (no auth requirement for youth)\n      allow create: if (isSignedIn() && \n                       request.auth.uid == userId &&\n                       validateUserDocument(request.resource.data)) ||\n                       // Allow backend to create youth member documents without auth\n                       (request.resource.data.get('isYouthMember', false) == true &&\n                       validateUserDocument(request.resource.data));\n\n      // Update: Users can update their own document, OR guardians can update dependents' documents,\n      // OR club-admin can update clubAccess field\n      allow update: if (request.auth.uid == userId && validateUserDocument(request.resource.data)) ||\n                       (isGuardianOf(userId) && validateUserDocument(request.resource.data)) ||\n                       (\n                         isSignedIn() &&\n                         request.auth.uid != userId &&\n                         // Check if current user is club admin in any of target user's clubs\n                         hasClubAdminAccessToUpdateUser(userId) &&\n                         // Club-admins can only update 'clubAccess', 'guardians', 'dependents', or flat role array fields\n                         request.resource.data.diff(resource.data).affectedKeys()\n                           .hasOnly(['clubAccess', 'guardians', 'dependents',\n                                     'adminOfClubs', 'memberOfClubs', 'adminOfGroups',\n                                     'coachOfGroups', 'memberOfGroups', 'guardianOfGroups'])\n                       );\n\n      // Delete: Users can only delete their own document\n      allow delete: if isSignedIn() && request.auth.uid == userId;\n\n      // ---------------------------\n      // Notifications subcollection - dual-storage architecture\n      // ---------------------------\n      match /notifications/{notificationId} {\n        // Read: User can read their own notifications OR guardians can read their dependents' notifications\n        allow read: if isSignedIn() && (\n          request.auth.uid == userId ||\n          isGuardianOf(userId)\n        );\n        \n        // Create: Backend functions can create notifications for users\n        // Client cannot create notifications directly (must use backend function)\n        allow create: if false;\n        \n        // Update: User can update their own notifications OR guardians can update dependents' notifications\n        allow update: if isSignedIn() && \n                         (request.auth.uid == userId || isGuardianOf(userId)) &&\n                         // Only allow updating specific fields\n                         request.resource.data.diff(resource.data).affectedKeys()\n                           .hasOnly(['read', 'readAt', 'dismissed', 'dismissedAt', 'actionTakenAt']);\n        \n        // Delete: Users can delete their own notifications OR guardians can delete dependents' notifications\n        allow delete: if isSignedIn() && (\n          request.auth.uid == userId ||\n          isGuardianOf(userId)\n        );\n      }\n    }\n\n    // ---------------------------\n    // Clubs collection\n    // ---------------------------\n    match /clubs/{clubId} {\n      // Read: Any authenticated user can read club info\n      allow read: if isSignedIn();\n      \n      // Create: Any authenticated user can create a club\n      allow create: if isSignedIn();\n      \n      // Update/Delete: Only club admins or club creator\n      allow update, delete: if isClubAdmin(clubId) || isClubCreator(clubId);\n\n      // All Members subcollection at club level - contains member documents/arrays for the club\n      match /allMembers/{memberId} {\n        // Read: Only club admins can read club member data\n        // Membership checks now done via backend checkMembership function\n        allow read: if isClubAdmin(clubId);\n        \n        // Create/Update: Only club admins can manage club-level members\n        allow create, update: if isClubAdmin(clubId);\n        \n        // Delete: Only club admins can remove members\n        allow delete: if isClubAdmin(clubId);\n      }\n\n      // Club-level Events subcollection\n      match /events/{eventId} {\n        // Read: Only invited members OR club admins can read events (privacy for group/subgroup events)\n        allow read: if isSignedIn() && (\n          request.auth.uid in resource.data.invitedUserIds ||\n          isClubAdmin(clubId)\n        );\n        \n        // Create/Update/Delete: Only club admins can manage club-level events\n        allow create, update, delete: if isClubAdmin(clubId);\n      }\n\n      // Club-level News subcollection\n      match /news/{newsId} {\n        // Read: Only recipients OR club admins can read news\n        allow read: if isSignedIn() && (\n          request.auth.uid in resource.data.recipientUserIds ||\n          isClubAdmin(clubId)\n        );\n        \n        // Update: Recipients can mark news as read (only readBy/readCount fields)\n        allow update: if isSignedIn() && \n          request.auth.uid in resource.data.recipientUserIds &&\n          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'readCount']);\n        \n        // Delete: Creator or club admin can delete news\n        allow delete: if isSignedIn() && (\n          resource.data.createdBy == request.auth.uid ||\n          isClubAdmin(clubId)\n        );\n        \n        // Create: Only via Cloud Functions (Admin SDK bypasses rules)\n        allow create: if false;\n      }\n      \n      // Note: Cloud Functions using Admin SDK bypass these rules entirely\n\n      // Groups subcollection inside a club\n      match /groups/{groupId} {\n        // Read: Any authenticated user can read group info\n        allow read: if isSignedIn();\n        \n        // Create: Only club admins can create groups\n        allow create: if canCreateGroup(clubId);\n        \n        // Update: Club admins or group admins/coaches can update\n        allow update: if canManageGroup(clubId, groupId);\n        \n        // Delete: Only club admins or group admins\n        allow delete: if isClubAdmin(clubId) || isGroupAdmin(clubId, groupId);\n        \n        // Subgroups subcollection\n        match /subgroups/{subgroupId} {\n          allow read: if isSignedIn();\n          allow create, update, delete: if canManageGroup(clubId, groupId);\n          \n          // Subgroup members subcollection\n          match /allMembers/{memberId} {\n            allow read: if isClubAdmin(clubId) || canManageGroup(clubId, groupId) || hasGroupAccess(clubId, groupId);\n            allow create, update: if isClubAdmin(clubId) || canManageGroup(clubId, groupId);\n            allow delete: if isClubAdmin(clubId) || isGroupAdmin(clubId, groupId);\n          }\n        }\n\n        // All Members subcollection - contains member documents for the group\n        match /allMembers/{memberId} {\n          // Read: Club admins, group admins/coaches, or group members can read member data\n          // Membership checks now done via backend checkMembership function for better security\n          allow read: if isClubAdmin(clubId) || canManageGroup(clubId, groupId) || hasGroupAccess(clubId, groupId);\n          \n          // Create/Update: Only club admins or group admins/coaches can manage members\n          allow create, update: if isClubAdmin(clubId) || canManageGroup(clubId, groupId);\n          \n          // Delete: Only club admins or group admins can remove members\n          allow delete: if isClubAdmin(clubId) || isGroupAdmin(clubId, groupId);\n        }\n\n        // Events subcollection (for future use)\n        match /events/{eventId} {\n          allow read: if hasGroupAccess(clubId, groupId) || isClubAdmin(clubId);\n          allow create, update, delete: if canManageGroup(clubId, groupId);\n        }\n\n        // Results subcollection (for future use)\n        match /results/{resultId} {\n          allow read: if hasGroupAccess(clubId, groupId) || isClubAdmin(clubId);\n          allow create, update, delete: if canManageGroup(clubId, groupId);\n        }\n      }\n    }\n\n    // ---------------------------\n    // Invitations collection - dual-storage source of truth\n    // ---------------------------\n    match /invitations/{invitationId} {\n      // Read: User can read invitations sent to their email OR created by them\n      // For youth invitations, guardians can read invitations for their dependents\n      // Allow list queries for user's own invitations\n      allow read: if isSignedIn() && \n                     (resource.data.email == request.auth.token.email ||\n                      resource.data.userId == request.auth.uid ||\n                      resource.data.inviterUid == request.auth.uid ||\n                      // Allow reading youth invitations if user is guardian\n                      (resource.data.get('invitationType', '') == 'youth_member' &&\n                       resource.data.email == request.auth.token.email));\n      \n      // Allow list operations (queries) for user's email or userId\n      allow list: if isSignedIn();\n      \n      // Create: Backend functions only (not directly by clients)\n      allow create: if false;\n      \n      // Update: Backend functions only (status changes handled by backend)\n      allow update: if false;\n      \n      // Delete: Only invitation creator or backend functions\n      allow delete: if isSignedIn() && resource.data.inviterUid == request.auth.uid;\n    }\n\n    // ---------------------------\n    // Guardian Invitations collection (for future use)\n    // ---------------------------\n    match /guardianInvitations/{invitationId} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn();\n      allow update, delete: if isSignedIn() && \n                            (resource.data.createdBy == request.auth.uid || \n                             resource.data.guardianEmail == request.auth.token.email);\n    }\n\n    // ---------------------------\n    // Global Events collection (for future use)\n    // ---------------------------\n    match /events/{eventId} {\n      allow read: if isSignedIn();\n      allow create: if isSignedIn();\n      allow update, delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;\n    }\n\n    // ---------------------------\n    // Membership Fees collection\n    // ---------------------------\n    match /membershipFees/{feeId} {\n      // Read: Club admins can read all fees for their club\n      //       Group members can read fees for their group\n      allow read: if isSignedIn() && (\n        // Club admin can see all fees for their club\n        isClubAdmin(resource.data.clubId) ||\n        // Group members can see fees for their group\n        hasGroupAccess(resource.data.clubId, resource.data.groupId)\n      );\n      \n      // Create: Backend only (via createMembershipFee function)\n      allow create: if false;\n      \n      // Update: Backend only (via webhook for payment tracking)\n      allow update: if false;\n      \n      // Delete: Never delete fees, use status='closed' instead\n      allow delete: if false;\n    }\n\n    // ---------------------------\n    // Payments collection\n    // ---------------------------\n    match /payments/{paymentId} {\n      // Read: Users can read their own payments (as payer or beneficiary)\n      //       Club admins can read all payments for their club\n      allow read: if isSignedIn() && (\n        // User is the payer\n        request.auth.uid == resource.data.payerId ||\n        // User is the beneficiary\n        request.auth.uid == resource.data.beneficiaryId ||\n        // User is club admin\n        isClubAdmin(resource.data.clubId)\n      );\n      \n      // Write: Backend only (via checkout and webhook functions)\n      allow create, update, delete: if false;\n    }\n\n    // ---------------------------\n    // Stripe Events collection (idempotency tracking)\n    // ---------------------------\n    match /stripeEvents/{eventId} {\n      // All access is backend only (webhook handler)\n      allow read, write: if false;\n    }\n  }\n}\n"}]}}
