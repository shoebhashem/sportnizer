{},"callableTrigger":{},"entryPoint":"createNews"},"getLegalConfig":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"getLegalConfig"},"recordLegalAcceptance":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"recordLegalAcceptance"},"getPersonnummerStatus":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"getPersonnummerStatus"},"removePersonnummer":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"removePersonnummer"},"storePersonnummer":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"storePersonnummer"},"generateKommunExport":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"generateKommunExport"},"deleteLokReport":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"deleteLokReport"},"generateLokReport":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"generateLokReport"},"getLokReport":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"getLokReport"},"listLokReports":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"listLokReports"},"checkRfApiStatus":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"checkRfApiStatus"},"submitLokReportToRf":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"submitLokReportToRf"},"updateClubRfSettings":{"availableMemoryMb":null,"timeoutSeconds":null,"minInstances":null,"maxInstances":null,"ingressSettings":null,"concurrency":null,"serviceAccountEmail":null,"vpc":null,"platform":"gcfv2","region":["europe-north1"],"labels":{},"callableTrigger":{},"entryPoint":"updateClubRfSettings"}},"specVersion":"v1alpha1","req