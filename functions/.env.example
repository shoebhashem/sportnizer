# Firebase Functions Environment Variables
# Copy this file to .env and add your actual SMTP credentials

# SMTP Configuration for noreply@clubnizer.com
SMTP_USER=noreply@clubnizer.com
SMTP_PASSWORD=your_email_password_here


# Additional environment variables can be added below
# Use Firebase CLI to set them: firebase functions:config:set smtp.user="noreply@clubnizer.com" smtp.password="your_password"
