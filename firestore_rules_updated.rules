rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidUser() {
      return isSignedIn();
      // TODO: Enable email verification in production
      // return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    // Users collection - for user profiles
    match /users/{userId} {
      // Users can read any user profile (for search and member lists)
      allow read: if isSignedIn();
      
      // Users can only write their own profile
      // Exception: admins can update user roles through group management
      allow write: if isSignedIn() && request.auth.uid == userId;
      
      // Allow querying users by email for resend verification functionality
      allow list: if isSignedIn();
    }
    
    // Email verification collection - for custom email verification
    match /emailVerifications/{tokenId} {
      // Only Firebase Functions should access this collection
      // However, we need some client access for error handling
      allow read, write: if false; // Restrict client access - only functions should use this
    }
    
    // Groups collection (renamed from sportsGroups) - NOW MOVED TO SUBCOLLECTION UNDER CLUBS
    // match /groups/{groupId} {
    //   ... old rules moved to clubs/{clubId}/groups/{groupId} below
    // }

    // CLUBS COLLECTION - New top-level collection
    match /clubs/{clubId} {
      // Helper functions for club access
      function isClubMember() {
        return isSignedIn() && 
               exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberIds;
      }
      
      function isClubAdmin() {
        return isSignedIn() && 
               exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
               request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.adminIds;
      }
      
      function canManageClub() {
        return isClubAdmin();
      }

      // Anyone authenticated can read clubs (for discovery)
      allow read: if isSignedIn();
      
      // Only authenticated users can create clubs (creator becomes admin)
      allow create: if isValidUser() &&
                   request.resource.data.createdBy == request.auth.uid &&
                   request.resource.data.keys().hasAll(['name', 'createdBy', 'createdAt', 'adminIds', 'memberIds', 'isActive']) &&
                   request.auth.uid in request.resource.data.adminIds &&
                   request.auth.uid in request.resource.data.memberIds;
      
      // Only club admin can update club details
      allow update: if isSignedIn() && 
                   isClubAdmin() &&
                   request.resource.data.createdBy == resource.data.createdBy; // Prevent ownership transfer
      
      // Only club admin can delete clubs
      allow delete: if isSignedIn() && isClubAdmin();
      
      // GROUPS SUBCOLLECTION - Groups now belong to clubs
      match /groups/{groupId} {
        // Helper functions for role checking within groups
        function getUserGroupRoles() {
          // Returns array of roles for the current user in this group
          // Should return ['admin'], ['coach'], ['member'], ['guardian'], or combinations
          return exists(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/members/$(request.auth.uid)) ?
                 get(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/members/$(request.auth.uid)).data.roles : [];
        }
        
        function hasGroupRole(role) {
          let roles = getUserGroupRoles();
          return roles is list && role in roles;
        }
        
        function isGroupMember() {
          return exists(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/members/$(request.auth.uid));
        }
        
        function isGroupAdmin() {
          return hasGroupRole('admin') || isClubAdmin(); // Club admins are also group admins
        }
        
        function isGroupCoach() {
          return hasGroupRole('coach');
        }
        
        function hasAdminOrCoachRole() {
          return hasGroupRole('admin') || hasGroupRole('coach') || isClubAdmin();
        }
        
        function isGuardian() {
          return hasGroupRole('guardian');
        }
        
        function canManageGroup() {
          return hasAdminOrCoachRole();
        }
        
        function canPromoteToAdmin() {
          return hasGroupRole('admin') || isClubAdmin(); // Only group/club admins can create other admins
        }
        
        function canManageMembers() {
          return hasGroupRole('admin') || hasGroupRole('coach') || isClubAdmin();
        }
        
        function canCreateContent() {
          // Only admin/coach can create events, polls, announcements
          // Guardians cannot create content unless they also have coach role
          return hasGroupRole('admin') || hasGroupRole('coach') || isClubAdmin();
        }
        
        function isGuardianOfMember(memberId) {
          return exists(/databases/$(database)/documents/clubs/$(clubId)/groups/$(groupId)/members/$(memberId)/guardians/$(request.auth.uid));
        }
        
        function canAccessChildData(memberId) {
          return canManageMembers() || isGuardianOfMember(memberId);
        }

        // Club admins can read all groups in their club
        // Non-admin club members can only read groups they're members of
        allow read: if isSignedIn() && (isClubAdmin() || isGroupMember());
        
        // Club admins and authenticated users can create groups within the club
        allow create: if isValidUser() &&
                     request.resource.data.createdBy == request.auth.uid &&
                     request.resource.data.clubId == clubId &&
                     (isClubAdmin() || isSignedIn()) && // Allow any authenticated user to create groups, but they must be in a club they're admin of
                     request.resource.data.keys().hasAll(['name', 'sportType', 'clubId', 'createdBy', 'createdAt', 'adminIds', 'memberIds', 'isActive']);
        
        // Only group admin or club admin can update group details
        allow update: if isSignedIn() && 
                     (isGroupAdmin() || isClubAdmin()) &&
                     request.resource.data.createdBy == resource.data.createdBy; // Prevent ownership transfer
        
        // Only group admin or club admin can delete groups
        allow delete: if isSignedIn() && (isGroupAdmin() || isClubAdmin());
        
        // Group members subcollection
        match /members/{memberId} {
          // Club admins can read all group members
          // Group members can read member list
          // Guardians can read their children's data
          allow read: if isSignedIn() && 
                     (isClubAdmin() || isGroupMember() || isGuardianOfMember(memberId));
          
          // Admin and coach can add members, users can add themselves when joining
          allow create: if isSignedIn() && 
                       (canManageMembers() || memberId == request.auth.uid) &&
                       // Validate roles array structure if provided
                       (!('roles' in request.resource.data) || 
                        (request.resource.data.roles is list && 
                         request.resource.data.roles.size() > 0 &&
                         request.resource.data.roles.size() <= 3 &&
                         // Validate that all roles are valid
                         request.resource.data.roles.toSet().isSubsetOf(['admin', 'coach', 'member', 'guardian'].toSet())));
          
          // Enhanced update rules for multiple roles
          allow update: if isSignedIn() && 
                       (
                         // Admins can update anyone's roles (including adding admin role)
                         (hasGroupRole('admin') || isClubAdmin()) ||
                         
                         // Coaches can update member roles but cannot promote to admin
                         (hasGroupRole('coach') && memberId != request.auth.uid && 
                          (!('roles' in request.resource.data) || 
                           !('admin' in request.resource.data.roles))) ||
                         
                         // Members can update their own info but not roles
                         (memberId == request.auth.uid && 
                          (!('roles' in request.resource.data) || request.resource.data.roles == resource.data.roles))
                       ) &&
                       // Additional validation for roles array
                       (!('roles' in request.resource.data) || 
                        (request.resource.data.roles is list && 
                         request.resource.data.roles.size() > 0 &&
                         request.resource.data.roles.size() <= 3 &&
                         // Validate that all roles are valid
                         request.resource.data.roles.toSet().isSubsetOf(['admin', 'coach', 'member', 'guardian'].toSet())));
                       
          // Admin and coach can remove members, members can remove themselves
          allow delete: if isSignedIn() && 
                       (canManageMembers() || memberId == request.auth.uid);
          
          // Guardians subcollection for child members
          match /guardians/{guardianId} {
            // Group admins and coaches can read guardian information
            // Guardians can read their own guardian records
            // Group members can also read guardian information (needed for guardian relationship checking)
            allow read: if isSignedIn() && 
                       (canManageMembers() || 
                        resource.data.guardianUserId == request.auth.uid ||
                        isGroupMember() || isClubMember());
            
            // Admin and coach can add guardians to children
            // Guardians can add themselves during registration process
            allow create: if isSignedIn() && 
                         (canManageMembers() || 
                          request.resource.data.guardianUserId == request.auth.uid) &&
                         // Validate guardian data structure
                         request.resource.data.keys().hasAll(['guardianUserId', 'relationship', 'contactEmail', 'addedAt']) &&
                         request.resource.data.relationship in ['mother', 'father', 'guardian'];
            
            // Admin, coach, and the guardian themselves can update guardian info
            allow update: if isSignedIn() && 
                         (canManageMembers() || 
                          resource.data.guardianUserId == request.auth.uid) &&
                         // Prevent changing guardianUserId after creation
                         request.resource.data.guardianUserId == resource.data.guardianUserId;
            
            // Admin and coach can remove guardians
            allow delete: if isSignedIn() && canManageMembers();
          }
        }
        
        // EVENTS SUBCOLLECTION - Events now belong to groups within clubs
        match /events/{eventId} {
          // Club admins can read all events in their club
          // Group members can read events
          // Guardians can also read events (to see their children's events)
          allow read: if isSignedIn() && (isClubAdmin() || isGroupMember() || isGuardian());
          
          // Only admin and coach can create events (guardians cannot unless they also have coach role)
          allow create: if isValidUser() &&
                       request.resource.data.createdBy == request.auth.uid &&
                       canCreateContent();
          
          // Event creator, admin, and coach can update events
          allow update: if isSignedIn() && 
                       (resource.data.createdBy == request.auth.uid || canCreateContent()) &&
                       request.resource.data.createdBy == resource.data.createdBy;
          
          // Event creator, admin, and coach can delete events
          allow delete: if isSignedIn() && 
                       (resource.data.createdBy == request.auth.uid || canCreateContent());
        }
        
        // POLLS SUBCOLLECTION - Polls now belong to groups within clubs
        match /polls/{pollId} {
          // Group members can read polls
          // Guardians can also read polls
          allow read: if isSignedIn() && (isGroupMember() || isGuardian() || isClubMember());
          
          // Only admin and coach can create polls
          allow create: if isValidUser() &&
                       request.resource.data.createdBy == request.auth.uid &&
                       canCreateContent();
          
          // Poll creator, admin, and coach can update polls
          allow update: if isSignedIn() && 
                       (resource.data.createdBy == request.auth.uid || canCreateContent()) &&
                       request.resource.data.createdBy == resource.data.createdBy;
          
          // Poll creator, admin, and coach can delete polls
          allow delete: if isSignedIn() && 
                       (resource.data.createdBy == request.auth.uid || canCreateContent());
        }
        
        // ANNOUNCEMENTS SUBCOLLECTION - Announcements now belong to groups within clubs
        match /announcements/{announcementId} {
          // Group members can read announcements
          // Guardians can also read announcements
          allow read: if isSignedIn() && (isGroupMember() || isGuardian() || isClubMember());
          
          // Only admin and coach can create announcements
          allow create: if isValidUser() &&
                       request.resource.data.createdBy == request.auth.uid &&
                       canCreateContent();
          
          // Announcement creator, admin, and coach can update announcements
          allow update: if isSignedIn() && 
                       (resource.data.createdBy == request.auth.uid || canCreateContent()) &&
                       request.resource.data.createdBy == resource.data.createdBy;
          
          // Announcement creator, admin, and coach can delete announcements
          allow delete: if isSignedIn() && 
                       (resource.data.createdBy == request.auth.uid || canCreateContent());
        }
        
        // Group results subcollection
        match /results/{resultId} {
          // Group members can read results
          // Guardians can also read results
          allow read: if isSignedIn() && (isGroupMember() || isGuardian() || isClubMember());
          
          // Only admin and coach can create/update/delete results
          allow create, update, delete: if isSignedIn() && canCreateContent();
        }
        
        // Group subgroups subcollection
        match /subgroups/{subgroupId} {
          // Group members can read subgroups
          // Guardians can also read subgroups
          allow read: if isSignedIn() && (isGroupMember() || isGuardian() || isClubMember());
          
          // Only admin and coach can create/update/delete subgroups
          allow create: if isSignedIn() &&
                       request.resource.data.createdBy == request.auth.uid &&
                       canCreateContent();
          
          allow update, delete: if isSignedIn() && canCreateContent();
        }
      }
    }
    
    // Guardian confirmation invitations - for ageGroup 1 child registration
    match /guardianConfirmationInvitations/{invitationId} {
      // Anyone can read with valid invitation code (needed for registration)
      allow read: if true;
      
      // Only authenticated admins/coaches can create guardian invitations
      allow create: if isSignedIn();
      
      // Guardians can update invitations when accepting/confirming
      allow update: if isSignedIn();
      
      // Clean up - admins can delete expired invitations
      allow delete: if isSignedIn();
    }
    
    // Coach invitations collection
    match /coachInvitations/{invitationId} {
      // Anyone can read with valid invitation code
      allow read: if true;
      
      // Only authenticated users can create coach invitations
      allow create: if isSignedIn();
      
      // Users can update invitations they were invited to
      allow update: if isSignedIn();
      
      // Admins can delete expired invitations
      allow delete: if isSignedIn();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      
      // Users can mark their own notifications as read
      allow update: if isSignedIn() && 
                   request.auth.uid == resource.data.userId &&
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      
      // Users can delete their own notifications
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // OLD TOP-LEVEL COLLECTIONS - NOW MOVED TO SUBCOLLECTIONS UNDER CLUBS
    // These collections are no longer used as top-level collections
    // All events, polls, and announcements are now subcollections under clubs/{clubId}/groups/{groupId}/
    
    /*
    // TOP-LEVEL EVENTS COLLECTION - DEPRECATED - NOW SUBCOLLECTION
    match /events/{eventId} {
      // MOVED TO: clubs/{clubId}/groups/{groupId}/events/{eventId}
    }

    // TOP-LEVEL POLLS COLLECTION - DEPRECATED - NOW SUBCOLLECTION
    match /polls/{pollId} {
      // MOVED TO: clubs/{clubId}/groups/{groupId}/polls/{pollId}
    }

    // TOP-LEVEL ANNOUNCEMENTS COLLECTION - DEPRECATED - NOW SUBCOLLECTION
    match /announcements/{announcementId} {
      // MOVED TO: clubs/{clubId}/groups/{groupId}/announcements/{announcementId}
    }
    */

    // Invitations collection - for email invitations
    match /invitations/{invitationId} {
      // Anyone can read invitations (needed for signup with invitation tokens)
      allow read: if true;
      
      // Only authenticated users can create invitations (via Cloud Functions)
      allow create: if isSignedIn();
      
      // Users can update invitations they were invited to
      allow update: if isSignedIn();
    }
  }
}
