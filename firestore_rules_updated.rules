rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidUser() {
      return isSignedIn();
      // TODO: Enable email verification in production
      // return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    // Users collection - for user profiles
    match /users/{userId} {
      // Users can read any user profile (for search and member lists)
      allow read: if isSignedIn();
      
      // Users can only write their own profile
      // Exception: admins can update user roles through group management
      allow write: if isSignedIn() && request.auth.uid == userId;
      
      // Allow querying users by email for resend verification functionality
      allow list: if isSignedIn();
    }
    
    // Email verification collection - for custom email verification
    match /emailVerifications/{tokenId} {
      // Only Firebase Functions should access this collection
      // However, we need some client access for error handling
      allow read, write: if false; // Restrict client access - only functions should use this
    }
    
    // Groups collection (renamed from sportsGroups)
    match /groups/{groupId} {
      // Helper functions for role checking
      function getUserRole() {
        return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ?
               get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role : 'none';
      }
      
      function isGroupMember() {
        return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }
      
      function isGroupAdmin() {
        return getUserRole() == 'admin';
      }
      
      function isGroupCoach() {
        return getUserRole() == 'coach';
      }
      
      function canManageGroup() {
        return isGroupAdmin() || isGroupCoach();
      }
      
      // Anyone authenticated can read groups (for discovery)
      allow read: if isSignedIn();
      
      // Only authenticated users can create groups (creator becomes admin)
      allow create: if isValidUser() &&
                   request.resource.data.createdBy == request.auth.uid &&
                   request.resource.data.keys().hasAll(['name', 'sportType', 'location', 'createdBy', 'createdAt', 'membersCount']);
      
      // Only group admin can update group details
      allow update: if isSignedIn() && 
                   isGroupAdmin() &&
                   request.resource.data.createdBy == resource.data.createdBy; // Prevent ownership transfer
      
      // Only group admin can delete groups
      allow delete: if isSignedIn() && isGroupAdmin();
      
      // Group members subcollection
      match /members/{memberId} {
        // Group members can read member list
        allow read: if isSignedIn() && isGroupMember();
        
        // Admin and coach can add members, users can add themselves when joining
        allow create: if isSignedIn() && 
                     (canManageGroup() || memberId == request.auth.uid);
        
        // Admin can update any member role (including making coaches)
        // Coach can update member roles (but not promote to admin)
        // Members can update their own info (but not role)
        allow update: if isSignedIn() && 
                     (isGroupAdmin() ||
                      (isGroupCoach() && memberId != request.auth.uid && request.resource.data.role != 'admin') ||
                      (memberId == request.auth.uid && request.resource.data.role == resource.data.role));
                     
        // Admin and coach can remove members, members can remove themselves
        allow delete: if isSignedIn() && 
                     (canManageGroup() || memberId == request.auth.uid);
      }
      
      // Group events subcollection  
      match /events/{eventId} {
        // Group members can read events
        allow read: if isSignedIn() && isGroupMember();
        
        // Admin and coach can create events
        allow create: if isValidUser() &&
                     request.resource.data.createdBy == request.auth.uid &&
                     canManageGroup();
        
        // Event creator, admin, and coach can update events
        allow update: if isSignedIn() && 
                     (resource.data.createdBy == request.auth.uid || canManageGroup()) &&
                     request.resource.data.createdBy == resource.data.createdBy;
        
        // Event creator, admin, and coach can delete events
        allow delete: if isSignedIn() && 
                     (resource.data.createdBy == request.auth.uid || canManageGroup());
      }
      
      // Group results subcollection
      match /results/{resultId} {
        // Group members can read results
        allow read: if isSignedIn() && isGroupMember();
        
        // Admin and coach can create/update/delete results
        allow create, update, delete: if isSignedIn() && canManageGroup();
      }
      
      // Group subgroups subcollection
      match /subgroups/{subgroupId} {
        // Group members can read subgroups
        allow read: if isSignedIn() && isGroupMember();
        
        // Admin and coach can create/update/delete subgroups
        allow create: if isValidUser() &&
                     request.resource.data.createdBy == request.auth.uid &&
                     canManageGroup();
        
        allow update, delete: if isSignedIn() && canManageGroup();
      }
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      
      // Users can mark their own notifications as read
      allow update: if isSignedIn() && 
                   request.auth.uid == resource.data.userId &&
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      
      // Users can delete their own notifications
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // Invitations collection - for email invitations
    match /invitations/{invitationId} {
      // Anyone can read invitations (needed for signup with invitation tokens)
      allow read: if true;
      
      // Only authenticated users can create invitations (via Cloud Functions)
      allow create: if isSignedIn();
      
      // Users can update invitations they were invited to
      allow update: if isSignedIn();
    }
  }
}
