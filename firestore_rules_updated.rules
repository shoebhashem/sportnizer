rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidUser() {
      return isSignedIn();
      // TODO: Enable email verification in production
      // return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    // Users collection - for user profiles
    match /users/{userId} {
      // Users can read any user profile (for search and member lists)
      allow read: if isSignedIn();
      
      // Users can only write their own profile
      // Exception: admins can update user roles through group management
      allow write: if isSignedIn() && request.auth.uid == userId;
      
      // Allow querying users by email for resend verification functionality
      allow list: if isSignedIn();
    }
    
    // Email verification collection - for custom email verification
    match /emailVerifications/{tokenId} {
      // Only Firebase Functions should access this collection
      // However, we need some client access for error handling
      allow read, write: if false; // Restrict client access - only functions should use this
    }
    
    // Groups collection (renamed from sportsGroups)
    match /groups/{groupId} {
      // Helper functions for role checking
      function getUserRoles() {
        return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ?
               get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.roles : [];
      }
      
      function getUserRole() {
        // Legacy support - returns primary role or first role in array
        let roles = getUserRoles();
        return roles is list ? (roles.size() > 0 ? roles[0] : 'member') : 
               exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) ?
               get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role : 'none';
      }
      
      function hasRole(role) {
        let roles = getUserRoles();
        return roles is list ? role in roles : getUserRole() == role;
      }
      
      function isGroupMember() {
        return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }
      
      function isGroupAdmin() {
        return hasRole('admin');
      }
      
      function isGroupCoach() {
        return hasRole('coach');
      }
      
      function hasAdminOrCoachRole() {
        return hasRole('admin') || hasRole('coach');
      }
      
      function isGuardian() {
        return hasRole('guardian');
      }
      
      function canManageGroup() {
        return hasAdminOrCoachRole();
      }
      
      function canPromoteToAdmin() {
        return hasRole('admin'); // Only admins can create other admins
      }
      
      function canManageMembers() {
        return hasRole('admin') || hasRole('coach');
      }
      
      function canCreateContent() {
        // Only admin/coach can create events, polls, announcements
        // Guardians cannot create content unless they also have coach role
        return hasRole('admin') || hasRole('coach');
      }
      
      function isGuardianOfMember(memberId) {
        return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(memberId)/guardians/$(request.auth.uid));
      }
      
      function canAccessChildData(memberId) {
        return canManageMembers() || isGuardianOfMember(memberId);
      }
      
      // Anyone authenticated can read groups (for discovery)
      allow read: if isSignedIn();
      
      // Only authenticated users can create groups (creator becomes admin)
      allow create: if isValidUser() &&
                   request.resource.data.createdBy == request.auth.uid &&
                   request.resource.data.keys().hasAll(['name', 'sportType', 'ageGroup', 'location', 'createdBy', 'createdAt', 'membersCount']) &&
                   request.resource.data.ageGroup is int &&
                   request.resource.data.ageGroup >= 1 && request.resource.data.ageGroup <= 3;
      
      // Only group admin can update group details
      allow update: if isSignedIn() && 
                   isGroupAdmin() &&
                   request.resource.data.createdBy == resource.data.createdBy; // Prevent ownership transfer
      
      // Only group admin can delete groups
      allow delete: if isSignedIn() && isGroupAdmin();
      
      // Group members subcollection
      match /members/{memberId} {
        // Group members can read member list
        // Guardians can read their children's data
        allow read: if isSignedIn() && 
                   (isGroupMember() || isGuardianOfMember(memberId));
        
        // Admin and coach can add members, users can add themselves when joining
        allow create: if isSignedIn() && 
                     (canManageMembers() || memberId == request.auth.uid) &&
                     // Validate roles array structure if provided
                     (!('roles' in request.resource.data) || 
                      (request.resource.data.roles is list && 
                       request.resource.data.roles.size() > 0 &&
                       request.resource.data.roles.size() <= 3 &&
                       // Validate that all roles are valid
                       request.resource.data.roles.toSet().isSubsetOf(['admin', 'coach', 'member', 'guardian'].toSet())));
        
        // Enhanced update rules for multiple roles
        allow update: if isSignedIn() && 
                     (
                       // Admins can update anyone's roles (including adding admin role)
                       (hasRole('admin')) ||
                       
                       // Coaches can update member roles but cannot promote to admin
                       (hasRole('coach') && memberId != request.auth.uid && 
                        (!('roles' in request.resource.data) || 
                         !('admin' in request.resource.data.roles))) ||
                       
                       // Members can update their own info but not roles
                       (memberId == request.auth.uid && 
                        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
                        (!('roles' in request.resource.data) || request.resource.data.roles == resource.data.roles))
                     ) &&
                     // Additional validation for roles array
                     (!('roles' in request.resource.data) || 
                      (request.resource.data.roles is list && 
                       request.resource.data.roles.size() > 0 &&
                       request.resource.data.roles.size() <= 3 &&
                       // Validate that all roles are valid
                       request.resource.data.roles.toSet().isSubsetOf(['admin', 'coach', 'member', 'guardian'].toSet())));
                     
        // Admin and coach can remove members, members can remove themselves
        allow delete: if isSignedIn() && 
                     (canManageMembers() || memberId == request.auth.uid);
        
        // Guardians subcollection for child members (ageGroup 1 & 3)
        match /guardians/{guardianId} {
          // Group admins and coaches can read guardian information
          // Guardians can read their own guardian records
          // Group members can also read guardian information (needed for guardian relationship checking)
          allow read: if isSignedIn() && 
                     (canManageMembers() || 
                      resource.data.guardianUserId == request.auth.uid ||
                      isGroupMember());
          
          // Admin and coach can add guardians to children
          // Guardians can add themselves during registration process
          allow create: if isSignedIn() && 
                       (canManageMembers() || 
                        request.resource.data.guardianUserId == request.auth.uid) &&
                       // Validate guardian data structure
                       request.resource.data.keys().hasAll(['guardianUserId', 'relationship', 'contactEmail', 'addedAt']) &&
                       request.resource.data.relationship in ['mother', 'father', 'guardian'];
          
          // Admin, coach, and the guardian themselves can update guardian info
          allow update: if isSignedIn() && 
                       (canManageMembers() || 
                        resource.data.guardianUserId == request.auth.uid) &&
                       // Prevent changing guardianUserId after creation
                       request.resource.data.guardianUserId == resource.data.guardianUserId;
          
          // Admin and coach can remove guardians
          allow delete: if isSignedIn() && canManageMembers();
        }
      }
      
      // Group events subcollection  
      match /events/{eventId} {
        // Group members can read events
        // Guardians can also read events (to see their children's events)
        allow read: if isSignedIn() && (isGroupMember() || isGuardian());
        
        // Only admin and coach can create events (guardians cannot unless they also have coach role)
        allow create: if isValidUser() &&
                     request.resource.data.createdBy == request.auth.uid &&
                     canCreateContent();
        
        // Event creator, admin, and coach can update events
        allow update: if isSignedIn() && 
                     (resource.data.createdBy == request.auth.uid || canCreateContent()) &&
                     request.resource.data.createdBy == resource.data.createdBy;
        
        // Event creator, admin, and coach can delete events
        allow delete: if isSignedIn() && 
                     (resource.data.createdBy == request.auth.uid || canCreateContent());
      }
      
      // Group results subcollection
      match /results/{resultId} {
        // Group members can read results
        // Guardians can also read results
        allow read: if isSignedIn() && (isGroupMember() || isGuardian());
        
        // Only admin and coach can create/update/delete results
        allow create, update, delete: if isSignedIn() && canCreateContent();
      }
      
      // Group subgroups subcollection
      match /subgroups/{subgroupId} {
        // Group members can read subgroups
        // Guardians can also read subgroups
        allow read: if isSignedIn() && (isGroupMember() || isGuardian());
        
        // Only admin and coach can create/update/delete subgroups
        allow create: if isValidUser() &&
                     request.resource.data.createdBy == request.auth.uid &&
                     canCreateContent();
        
        allow update, delete: if isSignedIn() && canCreateContent();
      }
    }
    
    // Guardian confirmation invitations - for ageGroup 1 child registration
    match /guardianConfirmationInvitations/{invitationId} {
      // Anyone can read with valid invitation code (needed for registration)
      allow read: if true;
      
      // Only authenticated admins/coaches can create guardian invitations
      allow create: if isSignedIn();
      
      // Guardians can update invitations when accepting/confirming
      allow update: if isSignedIn();
      
      // Clean up - admins can delete expired invitations
      allow delete: if isSignedIn();
    }
    
    // Coach invitations collection
    match /coachInvitations/{invitationId} {
      // Anyone can read with valid invitation code
      allow read: if true;
      
      // Only authenticated users can create coach invitations
      allow create: if isSignedIn();
      
      // Users can update invitations they were invited to
      allow update: if isSignedIn();
      
      // Admins can delete expired invitations
      allow delete: if isSignedIn();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      
      // Users can mark their own notifications as read
      allow update: if isSignedIn() && 
                   request.auth.uid == resource.data.userId &&
                   request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      
      // Users can delete their own notifications
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    // TOP-LEVEL EVENTS COLLECTION - NEW STRUCTURE FOR ACTIVITIES
    match /events/{eventId} {
      // Helper function to check if user has admin/coach role in any of the event's target groups
      function canManageEventGroups() {
        // Only users with admin or coach roles can manage events
        // Guardians cannot create/manage events unless they also have coach role
        return isSignedIn(); // TODO: Check admin/coach roles in target groups
      }

      // Anyone can read events (will be filtered by groupIds on client side)
      // Guardians can read events to see their children's activities
      allow read: if isSignedIn();
      
      // Only users with admin/coach roles can create events
      // Guardians cannot create events unless they also have coach role
      allow create: if isValidUser() && 
                   request.resource.data.createdBy == request.auth.uid &&
                   canManageEventGroups();
      
      // Event creator and users with admin/coach roles can update events
      allow update: if isSignedIn() && 
                   (request.auth.uid == resource.data.createdBy || canManageEventGroups()) &&
                   request.resource.data.createdBy == resource.data.createdBy; // Prevent ownership transfer
      
      // Event creator and admins/coaches can delete events
      allow delete: if isSignedIn() && 
                   (request.auth.uid == resource.data.createdBy || canManageEventGroups());
    }

    // TOP-LEVEL POLLS COLLECTION
    match /polls/{pollId} {
      // Helper function to check if user has admin/coach role in any of the poll's target groups
      function canManagePollGroups() {
        // Only users with admin or coach roles can manage polls
        // Guardians cannot create/manage polls unless they also have coach role
        return isSignedIn(); // TODO: Check admin/coach roles in target groups
      }

      // Anyone can read polls (will be filtered by groupIds on client side)
      // Guardians can read polls to participate in their children's activities
      allow read: if isSignedIn();
      
      // Only users with admin/coach roles can create polls
      // Guardians cannot create polls unless they also have coach role
      allow create: if isValidUser() && 
                   request.resource.data.createdBy == request.auth.uid &&
                   canManagePollGroups();
      
      // Poll creator and users with admin/coach roles can update polls
      allow update: if isSignedIn() && 
                   (request.auth.uid == resource.data.createdBy || canManagePollGroups()) &&
                   request.resource.data.createdBy == resource.data.createdBy; // Prevent ownership transfer
      
      // Poll creator and admins/coaches can delete polls
      allow delete: if isSignedIn() && 
                   (request.auth.uid == resource.data.createdBy || canManagePollGroups());
    }

    // TOP-LEVEL ANNOUNCEMENTS COLLECTION
    match /announcements/{announcementId} {
      // Helper function to check if user has admin/coach role in any of the announcement's target groups
      function canManageAnnouncementGroups() {
        // Only users with admin or coach roles can manage announcements
        // Guardians cannot create/manage announcements unless they also have coach role
        return isSignedIn(); // TODO: Check admin/coach roles in target groups
      }

      // Anyone can read announcements (will be filtered by groupIds on client side)
      // Guardians can read announcements to stay informed about their children's activities
      allow read: if isSignedIn();
      
      // Only users with admin/coach roles can create announcements
      // Guardians cannot create announcements unless they also have coach role
      allow create: if isValidUser() && 
                   request.resource.data.createdBy == request.auth.uid &&
                   canManageAnnouncementGroups();
      
      // Announcement creator and users with admin/coach roles can update announcements
      allow update: if isSignedIn() && 
                   (request.auth.uid == resource.data.createdBy || canManageAnnouncementGroups()) &&
                   request.resource.data.createdBy == resource.data.createdBy; // Prevent ownership transfer
      
      // Announcement creator and admins/coaches can delete announcements
      allow delete: if isSignedIn() && 
                   (request.auth.uid == resource.data.createdBy || canManageAnnouncementGroups());
    }

    // Invitations collection - for email invitations
    match /invitations/{invitationId} {
      // Anyone can read invitations (needed for signup with invitation tokens)
      allow read: if true;
      
      // Only authenticated users can create invitations (via Cloud Functions)
      allow create: if isSignedIn();
      
      // Users can update invitations they were invited to
      allow update: if isSignedIn();
    }
  }
}
